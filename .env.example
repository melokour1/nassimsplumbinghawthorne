# Copy these into your host's environment variables (Vercel > Settings >
# Environment Variables). Never commit real values -- .env is gitignored.
#
# Nothing here is strictly required: with none of it set the site still
# works, the assistant runs in offline mode, and the booking form falls
# back to a prefilled SMS. Each variable you add turns on one more piece.
# Check /api/health after any change.

# --- Lead storage (Supabase) -----------------------------------------
# Project Settings > API. Use the service_role key, NOT the anon key,
# and only ever server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telling management (Twilio SMS) ---------------------------------
# This is what makes "transfer to a person" actually reach anyone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OPS_SMS_TO=

# --- Telling management (Resend email) -------------------------------
# The durable record. Free tier covers a small business comfortably.
RESEND_API_KEY=
LEAD_EMAIL_FROM=
LEAD_EMAIL_TO=

# --- The assistant ---------------------------------------------------
# Without this the chat widget runs its built-in offline assistant.
ANTHROPIC_API_KEY=

# --- Admin lead view -------------------------------------------------
# Any long random string. Guards /api/leads and admin.html.
ADMIN_TOKEN=

# --- Browser origins allowed to call the API -------------------------
# Only needed if the site is served from a different domain than the API.
# Comma-separated, no trailing slash.
ALLOWED_ORIGINS=

# --- Live chat handoff (Telegram) ------------------------------------
# Create a bot with @BotFather, then add it to a group (or DM it) and
# send /help to see the chat id. This is what lets a PC visitor with no
# phone talk to a real person in the chat window.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any long random string. Telegram sends it back on every webhook call so
# nobody who guesses the URL can inject operator messages.
TELEGRAM_WEBHOOK_SECRET=

# Signs conversation tokens so a leaked conversation id cannot be used to
# read a transcript. Falls back to ADMIN_TOKEN if unset.
SESSION_SECRET=
